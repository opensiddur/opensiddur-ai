[run]
source = opensiddur
omit = 
    opensiddur/tests/*
    */__pycache__/*
    */test_*.py
    opensiddur/importer/wlc/download_tanach.py
    # Edition data/assembly recipes and disposable fixed-text inspection commands.
    # Reusable algorithms live in importer/scan and remain measured.
    opensiddur/importer/asher_selichot/build.py
    opensiddur/importer/asher_selichot/first_day.py
    opensiddur/importer/asher_selichot/second_day.py
    opensiddur/importer/asher_selichot/third_day.py
    opensiddur/importer/asher_selichot/erev_rosh_hashanah.py
    opensiddur/importer/asher_selichot/tzom_gedaliah.py
    opensiddur/importer/asher_selichot/penitential_second_day.py
    opensiddur/importer/asher_selichot/penitential_days.py
    opensiddur/importer/asher_selichot/identities.py
    opensiddur/importer/asher_selichot/download.py
    opensiddur/importer/asher_selichot/verify.py
    opensiddur/importer/asher_selichot/check_*pdf.py

[report]
precision = 2
show_missing = True
skip_covered = False
# `python -m module` entry points are exercised through main(argv) in the tests; the
# two-line __main__ guard itself is not reachable from a test that imports the module.
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:

[html]
directory = htmlcov

