{
  "description": "Which layer a value comes from: pinned over the reader over defaults over derived. Uses the derivations that run on the device: a minyan is also a zimmun; Ma'ariv has no repetition; a day that is not yom tov is none of the festivals that are yom tov throughout.",
  "cases": [
    {"name": "pinned beats the reader", "condition": "<tei:fs type='t:x'><tei:f name='a'><tei:binary value='true'/></tei:f></tei:fs>", "pinned": {"t:x": {"a": true}}, "reader": {"t:x": {"a": false}}, "expected": "true"},
    {"name": "reader beats a default", "condition": "<tei:fs type='t:x'><tei:f name='a'><tei:binary value='true'/></tei:f></tei:fs>", "reader": {"t:x": {"a": true}}, "defaults": {"t:x": {"a": false}}, "expected": "true"},
    {"name": "a feature the reader has not set takes the default", "condition": "<tei:fs type='t:x'><tei:f name='a'><tei:binary value='true'/></tei:f></tei:fs>", "reader": {"t:x": {"b": true}}, "defaults": {"t:x": {"a": false}}, "expected": "false"},
    {"name": "the reader's null shows every option, over a default", "condition": "<tei:fs type='t:x'><tei:f name='a'><tei:binary value='true'/></tei:f></tei:fs>", "reader": {"t:x": {"a": null}}, "defaults": {"t:x": {"a": false}}, "expected": "undefined"},
    {"name": "the reader's null minyan derives no zimmun", "condition": "<tei:fs type='opensiddur:quorum'><tei:f name='zimmun'><tei:binary value='true'/></tei:f></tei:fs>", "reader": {"opensiddur:quorum": {"minyan": null}}, "defaults": {"opensiddur:quorum": {"minyan": true}}, "expected": "undefined"},
    {"name": "a pinned null is pinned", "condition": "<tei:fs type='t:x'><tei:f name='a'><tei:binary value='true'/></tei:f></tei:fs>", "pinned": {"t:x": {"a": null}}, "reader": {"t:x": {"a": true}}, "expected": "undefined"},
    {"name": "a minyan is a zimmun", "condition": "<tei:fs type='opensiddur:quorum'><tei:f name='zimmun'><tei:binary value='true'/></tei:f></tei:fs>", "reader": {"opensiddur:quorum": {"minyan": true}}, "expected": "true"},
    {"name": "no minyan says nothing about a zimmun", "condition": "<tei:fs type='opensiddur:quorum'><tei:f name='zimmun'><tei:binary value='true'/></tei:f></tei:fs>", "reader": {"opensiddur:quorum": {"minyan": false}}, "expected": "undefined"},
    {"name": "a default minyan is a zimmun", "condition": "<tei:fs type='opensiddur:quorum'><tei:f name='zimmun'><tei:binary value='true'/></tei:f></tei:fs>", "defaults": {"opensiddur:quorum": {"minyan": true}}, "expected": "true"},
    {"name": "a pinned minyan is a zimmun", "condition": "<tei:fs type='opensiddur:quorum'><tei:f name='zimmun'><tei:binary value='true'/></tei:f></tei:fs>", "pinned": {"opensiddur:quorum": {"minyan": true}}, "expected": "true"},
    {"name": "an explicit zimmun is not derived over", "condition": "<tei:fs type='opensiddur:quorum'><tei:f name='zimmun'><tei:binary value='true'/></tei:f></tei:fs>", "reader": {"opensiddur:quorum": {"minyan": true, "zimmun": false}}, "expected": "false"},
    {"name": "an explicit null zimmun is not derived over", "condition": "<tei:fs type='opensiddur:quorum'><tei:f name='zimmun'><tei:binary value='true'/></tei:f></tei:fs>", "reader": {"opensiddur:quorum": {"minyan": true}}, "defaults": {"opensiddur:quorum": {"zimmun": null}}, "expected": "undefined"},
    {"name": "a truthy minyan is a minyan", "condition": "<tei:fs type='opensiddur:quorum'><tei:f name='zimmun'><tei:binary value='true'/></tei:f></tei:fs>", "pinned": {"opensiddur:quorum": {"minyan": {"num": 10}}}, "expected": "true"},
    {"name": "a minyan and a mourner", "condition": "<j:all><tei:fs type='opensiddur:quorum'><tei:f name='minyan'><tei:binary value='true'/></tei:f></tei:fs><tei:fs type='opensiddur:override'><tei:f name='house-of-mourning'><tei:binary value='false'/></tei:f></tei:fs></j:all>", "reader": {"opensiddur:quorum": {"minyan": true}}, "defaults": {"opensiddur:override": {"house-of-mourning": false}}, "expected": "true"},
    {"name": "Ma'ariv is not repeated", "condition": "<tei:fs type='opensiddur:recitation'><tei:f name='repetition'><tei:binary value='true'/></tei:f></tei:fs>", "reader": {"opensiddur:service-time": {"maariv": true}}, "expected": "false"},
    {"name": "Shaharit says nothing about the repetition", "condition": "<tei:fs type='opensiddur:recitation'><tei:f name='repetition'><tei:binary value='true'/></tei:f></tei:fs>", "reader": {"opensiddur:service-time": {"maariv": false}}, "expected": "undefined"},
    {"name": "a pinned repetition is not derived over", "condition": "<tei:fs type='opensiddur:recitation'><tei:f name='repetition'><tei:binary value='true'/></tei:f></tei:fs>", "pinned": {"opensiddur:recitation": {"repetition": true}}, "reader": {"opensiddur:service-time": {"maariv": true}}, "expected": "true"},
    {"name": "not yom tov is not Shavuot", "condition": "<tei:fs type='opensiddur:holiday'><tei:f name='shavuot'><tei:numeric value='1' max='2'/></tei:f></tei:fs>", "reader": {"opensiddur:holiday-aggregate": {"yom-tov": false}}, "expected": "false"},
    {"name": "not yom tov says nothing about Pesah", "condition": "<tei:fs type='opensiddur:holiday'><tei:f name='pesah'><tei:numeric value='1' max='8'/></tei:f></tei:fs>", "reader": {"opensiddur:holiday-aggregate": {"yom-tov": false}}, "expected": "undefined"},
    {"name": "yom tov says nothing about which festival", "condition": "<tei:fs type='opensiddur:holiday'><tei:f name='shavuot'><tei:numeric value='1' max='2'/></tei:f></tei:fs>", "reader": {"opensiddur:holiday-aggregate": {"yom-tov": true}}, "expected": "undefined"}
  ]
}
