    {"name": "the second day is yom tov outside Israel", "condition": "<tei:fs type='opensiddur:holiday-aggregate'><tei:f name='yom-tov'><tei:binary value='true'/></tei:f></tei:fs>", "device": {"opensiddur:gregorian-date": {"year": 2026, "month": 4, "day": 3}, "opensiddur:time": {"hour": 9, "minute": 0}}, "reader": {"opensiddur:location": {"latitude": 40.71, "longitude": -74.01, "timezone": "America/New_York"}}, "expected": "true"},
