{
  "description": "The calendar on the device: the clock's date and time (device), a place and a chosen day (reader), and the compile's pinned values, all derived over as a compile derives over its declarations. New York is 40.71, -74.01 in America/New_York; Pesah 5786 began on the evening of 1 April 2026.",
  "cases": [
    {"name": "the clock's day is Pesah", "condition": "<tei:fs type='opensiddur:holiday'><tei:f name='pesah'><tei:numeric value='1'/></tei:f></tei:fs>", "device": {"opensiddur:gregorian-date": {"year": 2026, "month": 4, "day": 2}, "opensiddur:time": {"hour": 9, "minute": 0}}, "reader": {"opensiddur:location": {"latitude": 40.71, "longitude": -74.01, "timezone": "America/New_York"}}, "expected": "true"},
    {"name": "the clock's day without a place says nothing of Pesah", "condition": "<tei:fs type='opensiddur:holiday'><tei:f name='pesah'><tei:numeric value='1'/></tei:f></tei:fs>", "device": {"opensiddur:gregorian-date": {"year": 2026, "month": 4, "day": 2}, "opensiddur:time": {"hour": 9, "minute": 0}}, "expected": "undefined"},
    {"name": "the clock's day without a place still has its parsha", "condition": "<tei:fs type='opensiddur:torah-reading'><tei:f name='diaspora-parsha'><tei:string>vayechi</tei:string></tei:f></tei:fs>", "device": {"opensiddur:gregorian-date": {"year": 2026, "month": 1, "day": 1}, "opensiddur:time": {"hour": 9, "minute": 0}}, "expected": "true"},
    {"name": "the evening before is already Pesah, after nightfall", "condition": "<tei:fs type='opensiddur:holiday'><tei:f name='pesah'><tei:numeric value='1'/></tei:f></tei:fs>", "device": {"opensiddur:gregorian-date": {"year": 2026, "month": 4, "day": 1}, "opensiddur:time": {"hour": 21, "minute": 0}}, "reader": {"opensiddur:location": {"latitude": 40.71, "longitude": -74.01, "timezone": "America/New_York"}}, "expected": "true"},
    {"name": "the evening before is not yet Pesah, in the afternoon", "condition": "<tei:fs type='opensiddur:holiday'><tei:f name='pesah'><tei:numeric value='1'/></tei:f></tei:fs>", "device": {"opensiddur:gregorian-date": {"year": 2026, "month": 4, "day": 1}, "opensiddur:time": {"hour": 15, "minute": 0}}, "reader": {"opensiddur:location": {"latitude": 40.71, "longitude": -74.01, "timezone": "America/New_York"}}, "expected": "false"},
    {"name": "a chosen day beats the clock", "condition": "<tei:fs type='opensiddur:holiday'><tei:f name='pesah'><tei:numeric value='1'/></tei:f></tei:fs>", "device": {"opensiddur:gregorian-date": {"year": 2026, "month": 1, "day": 1}, "opensiddur:time": {"hour": 9, "minute": 0}}, "reader": {"opensiddur:gregorian-date": {"year": 2026, "month": 4, "day": 2}, "opensiddur:time": {"hour": 9, "minute": 0}, "opensiddur:location": {"latitude": 40.71, "longitude": -74.01, "timezone": "America/New_York"}}, "expected": "true"},
    {"name": "the reader overrides a derived holiday", "condition": "<tei:fs type='opensiddur:holiday'><tei:f name='pesah'><tei:numeric value='1'/></tei:f></tei:fs>", "device": {"opensiddur:gregorian-date": {"year": 2026, "month": 4, "day": 2}, "opensiddur:time": {"hour": 9, "minute": 0}}, "reader": {"opensiddur:location": {"latitude": 40.71, "longitude": -74.01, "timezone": "America/New_York"}, "opensiddur:holiday": {"pesah": 0}}, "expected": "false"},
    {"name": "the reader's null shows every option over a derived value", "condition": "<tei:fs type='opensiddur:holiday'><tei:f name='pesah'><tei:numeric value='1'/></tei:f></tei:fs>", "device": {"opensiddur:gregorian-date": {"year": 2026, "month": 4, "day": 2}, "opensiddur:time": {"hour": 9, "minute": 0}}, "reader": {"opensiddur:location": {"latitude": 40.71, "longitude": -74.01, "timezone": "America/New_York"}, "opensiddur:holiday": {"pesah": null}}, "expected": "undefined"},
    {"name": "a pinned Hebrew date beats the clock", "condition": "<tei:fs type='opensiddur:holiday'><tei:f name='pesah'><tei:numeric value='1'/></tei:f></tei:fs>", "device": {"opensiddur:gregorian-date": {"year": 2026, "month": 1, "day": 1}, "opensiddur:time": {"hour": 9, "minute": 0}}, "reader": {"opensiddur:location": {"latitude": 40.71, "longitude": -74.01, "timezone": "America/New_York"}}, "pinned": {"opensiddur:hebrew-date": {"year": 5786, "month": 1, "day": 15}}, "expected": "true"},
    {"name": "a pinned holiday beats the clock", "condition": "<tei:fs type='opensiddur:holiday'><tei:f name='pesah'><tei:numeric value='1'/></tei:f></tei:fs>", "device": {"opensiddur:gregorian-date": {"year": 2026, "month": 1, "day": 1}, "opensiddur:time": {"hour": 9, "minute": 0}}, "reader": {"opensiddur:location": {"latitude": 40.71, "longitude": -74.01, "timezone": "America/New_York"}}, "pinned": {"opensiddur:holiday": {"pesah": 1}}, "expected": "true"},
    {"name": "a pinned holiday leaves the rest of the clock's day", "condition": "<tei:fs type='opensiddur:holiday-aggregate'><tei:f name='yom-tov'><tei:binary value='false'/></tei:f></tei:fs>", "device": {"opensiddur:gregorian-date": {"year": 2026, "month": 1, "day": 1}, "opensiddur:time": {"hour": 9, "minute": 0}}, "reader": {"opensiddur:location": {"latitude": 40.71, "longitude": -74.01, "timezone": "America/New_York"}}, "pinned": {"opensiddur:holiday": {"pesah": 1}}, "expected": "true"},
    {"name": "a pinned Ma'ariv derives the silent Amidah", "condition": "<tei:fs type='opensiddur:recitation'><tei:f name='repetition'><tei:binary value='false'/></tei:f></tei:fs>", "device": {"opensiddur:gregorian-date": {"year": 2026, "month": 1, "day": 1}, "opensiddur:time": {"hour": 9, "minute": 0}}, "reader": {"opensiddur:location": {"latitude": 40.71, "longitude": -74.01, "timezone": "America/New_York"}}, "pinned": {"opensiddur:service-time": {"maariv": true}}, "expected": "true"},
    {"name": "the clock's evening is Ma'ariv, and not repeated", "condition": "<tei:fs type='opensiddur:recitation'><tei:f name='repetition'><tei:binary value='false'/></tei:f></tei:fs>", "device": {"opensiddur:gregorian-date": {"year": 2026, "month": 1, "day": 1}, "opensiddur:time": {"hour": 20, "minute": 0}}, "reader": {"opensiddur:location": {"latitude": 40.71, "longitude": -74.01, "timezone": "America/New_York"}}, "expected": "true"},
    {"name": "Friday at bein hashmashot is doubtfully Shabbat", "condition": "<tei:fs type='opensiddur:holiday-aggregate'><tei:f name='shabbat'><tei:binary value='true'/></tei:f></tei:fs>", "device": {"opensiddur:gregorian-date": {"year": 2026, "month": 1, "day": 2}, "opensiddur:time": {"hour": 16, "minute": 45}}, "reader": {"opensiddur:location": {"latitude": 40.71, "longitude": -74.01, "timezone": "America/New_York"}}, "expected": "undefined"},
    {"name": "Friday at bein hashmashot is Friday or Shabbat", "condition": "<tei:fs type='opensiddur:day-of-week'><tei:f name='hebrew-day'><tei:numeric value='6' max='7'/></tei:f></tei:fs>", "device": {"opensiddur:gregorian-date": {"year": 2026, "month": 1, "day": 2}, "opensiddur:time": {"hour": 16, "minute": 45}}, "reader": {"opensiddur:location": {"latitude": 40.71, "longitude": -74.01, "timezone": "America/New_York"}}, "expected": "true"},
    {"name": "Israel follows from the place", "condition": "<tei:fs type='opensiddur:israel'><tei:f name='is-israel'><tei:binary value='true'/></tei:f></tei:fs>", "device": {"opensiddur:gregorian-date": {"year": 2026, "month": 1, "day": 1}, "opensiddur:time": {"hour": 9, "minute": 0}}, "reader": {"opensiddur:location": {"latitude": 31.778, "longitude": 35.235, "timezone": "Asia/Jerusalem"}}, "expected": "true"},
