{
  "description": "Matching one feature: each kind of value, and the cross-type comparisons the evaluator makes. Synthetic feature structures (t:x).",
  "cases": [
    {"name": "binary true matches true", "condition": "<tei:fs type='t:x'><tei:f name='a'><tei:binary value='true'/></tei:f></tei:fs>", "reader": {"t:x": {"a": true}}, "expected": "true"},
    {"name": "binary true against false", "condition": "<tei:fs type='t:x'><tei:f name='a'><tei:binary value='true'/></tei:f></tei:fs>", "reader": {"t:x": {"a": false}}, "expected": "false"},
    {"name": "unset feature is undefined", "condition": "<tei:fs type='t:x'><tei:f name='a'><tei:binary value='true'/></tei:f></tei:fs>", "expected": "undefined"},
    {"name": "null setting is undefined", "condition": "<tei:fs type='t:x'><tei:f name='a'><tei:binary value='true'/></tei:f></tei:fs>", "defaults": {"t:x": {"a": null}}, "expected": "undefined"},
    {"name": "binary true matches a plain 1", "condition": "<tei:fs type='t:x'><tei:f name='a'><tei:binary value='true'/></tei:f></tei:fs>", "reader": {"t:x": {"a": 1}}, "expected": "true"},
    {"name": "binary false matches a plain 0", "condition": "<tei:fs type='t:x'><tei:f name='a'><tei:binary value='false'/></tei:f></tei:fs>", "reader": {"t:x": {"a": 0}}, "expected": "true"},
    {"name": "binary true does not match a numeric 1", "condition": "<tei:fs type='t:x'><tei:f name='a'><tei:binary value='true'/></tei:f></tei:fs>", "pinned": {"t:x": {"a": {"num": 1}}}, "expected": "false"},
    {"name": "binary true does not match a string", "condition": "<tei:fs type='t:x'><tei:f name='a'><tei:binary value='true'/></tei:f></tei:fs>", "reader": {"t:x": {"a": "true"}}, "expected": "false"},
    {"name": "symbol matches the same string", "condition": "<tei:fs type='t:x'><tei:f name='rite'><tei:symbol value='ashkenaz'/></tei:f></tei:fs>", "reader": {"t:x": {"rite": "ashkenaz"}}, "expected": "true"},
    {"name": "symbol against another", "condition": "<tei:fs type='t:x'><tei:f name='rite'><tei:symbol value='ashkenaz'/></tei:f></tei:fs>", "reader": {"t:x": {"rite": "sefard"}}, "expected": "false"},
    {"name": "string matches the same text", "condition": "<tei:fs type='t:x'><tei:f name='s'><tei:string>a b</tei:string></tei:f></tei:fs>", "reader": {"t:x": {"s": "a b"}}, "expected": "true"},
    {"name": "symbol undefined is undefined", "condition": "<tei:fs type='t:x'><tei:f name='a'><tei:symbol value='undefined'/></tei:f></tei:fs>", "reader": {"t:x": {"a": true}}, "expected": "undefined"},
    {"name": "default is undefined", "condition": "<tei:fs type='t:x'><tei:f name='a'><tei:default/></tei:f></tei:fs>", "reader": {"t:x": {"a": true}}, "expected": "undefined"},
    {"name": "numeric equal to a plain number", "condition": "<tei:fs type='t:x'><tei:f name='n'><tei:numeric value='3'/></tei:f></tei:fs>", "reader": {"t:x": {"n": 3}}, "expected": "true"},
    {"name": "numeric equal to a numeric", "condition": "<tei:fs type='t:x'><tei:f name='n'><tei:numeric value='3'/></tei:f></tei:fs>", "pinned": {"t:x": {"n": {"num": 3}}}, "expected": "true"},
    {"name": "numeric against another number", "condition": "<tei:fs type='t:x'><tei:f name='n'><tei:numeric value='3'/></tei:f></tei:fs>", "reader": {"t:x": {"n": 4}}, "expected": "false"},
    {"name": "numeric 1 matches true", "condition": "<tei:fs type='t:x'><tei:f name='n'><tei:numeric value='1'/></tei:f></tei:fs>", "reader": {"t:x": {"n": true}}, "expected": "true"},
    {"name": "numeric against a string", "condition": "<tei:fs type='t:x'><tei:f name='n'><tei:numeric value='1'/></tei:f></tei:fs>", "reader": {"t:x": {"n": "1"}}, "expected": "false"},
    {"name": "numeric range includes its bounds", "condition": "<tei:fs type='t:x'><tei:f name='n'><tei:numeric value='1' max='2'/></tei:f></tei:fs>", "reader": {"t:x": {"n": 2}}, "expected": "true"},
    {"name": "numeric range excludes beyond", "condition": "<tei:fs type='t:x'><tei:f name='n'><tei:numeric value='1' max='2'/></tei:f></tei:fs>", "reader": {"t:x": {"n": 3}}, "expected": "false"},
    {"name": "decimal numeric", "condition": "<tei:fs type='t:x'><tei:f name='n'><tei:numeric value='1.5'/></tei:f></tei:fs>", "reader": {"t:x": {"n": 1.5}}, "expected": "true"},
    {"name": "vAlt matches any alternative", "condition": "<tei:fs type='t:x'><tei:f name='rite'><tei:vAlt><tei:symbol value='ashkenaz'/><tei:symbol value='sefard'/></tei:vAlt></tei:f></tei:fs>", "reader": {"t:x": {"rite": "sefard"}}, "expected": "true"},
    {"name": "vAlt matching none", "condition": "<tei:fs type='t:x'><tei:f name='rite'><tei:vAlt><tei:symbol value='ashkenaz'/><tei:symbol value='sefard'/></tei:vAlt></tei:f></tei:fs>", "reader": {"t:x": {"rite": "mizrah"}}, "expected": "false"},
    {"name": "vAlt with an undefined alternative", "condition": "<tei:fs type='t:x'><tei:f name='rite'><tei:vAlt><tei:symbol value='ashkenaz'/><tei:default/></tei:vAlt></tei:f></tei:fs>", "reader": {"t:x": {"rite": "mizrah"}}, "expected": "undefined"},
    {"name": "vNot negates a match", "condition": "<tei:fs type='t:x'><tei:f name='rite'><tei:vNot><tei:symbol value='ashkenaz'/></tei:vNot></tei:f></tei:fs>", "reader": {"t:x": {"rite": "ashkenaz"}}, "expected": "false"},
    {"name": "vNot negates a mismatch", "condition": "<tei:fs type='t:x'><tei:f name='rite'><tei:vNot><tei:symbol value='ashkenaz'/></tei:vNot></tei:f></tei:fs>", "reader": {"t:x": {"rite": "sefard"}}, "expected": "true"},
    {"name": "vNot keeps undefined", "condition": "<tei:fs type='t:x'><tei:f name='rite'><tei:vNot><tei:symbol value='ashkenaz'/></tei:vNot></tei:f></tei:fs>", "expected": "undefined"},
    {"name": "vNot of vAlt", "condition": "<tei:fs type='t:x'><tei:f name='rite'><tei:vNot><tei:vAlt><tei:symbol value='ashkenaz'/><tei:symbol value='sefard'/></tei:vAlt></tei:vNot></tei:f></tei:fs>", "reader": {"t:x": {"rite": "mizrah"}}, "expected": "true"},
    {"name": "several features are all required", "condition": "<tei:fs type='t:x'><tei:f name='a'><tei:binary value='true'/></tei:f><tei:f name='b'><tei:binary value='true'/></tei:f></tei:fs>", "reader": {"t:x": {"a": true, "b": false}}, "expected": "false"},
    {"name": "several features, one unknown", "condition": "<tei:fs type='t:x'><tei:f name='a'><tei:binary value='true'/></tei:f><tei:f name='b'><tei:binary value='true'/></tei:f></tei:fs>", "reader": {"t:x": {"a": true}}, "expected": "undefined"}
  ]
}
